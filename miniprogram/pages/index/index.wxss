.init-page {
  padding: 60rpx 40rpx;
  background-color: #FFFDF9;
  min-height: 100vh;
  box-sizing: border-box;
}

.text-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.top-icon-circle {
  width: 160rpx;
  height: 160rpx;
  background-color: white;
  border-radius: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  border: 8rpx solid #FFF0F2;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
  font-size: 80rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 900;
  color: #4A3A3A;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #9A8A8A;
  font-weight: 500;
}

.role-selection {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.role-card {
  background-color: white;
  border: 6rpx solid #FFF0F2;
  border-radius: 32rpx;
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 30rpx;
  transition: all 0.2s;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
}

.role-card:active {
  transform: scale(0.96);
}

.icon-circle {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  flex-shrink: 0;
}

.kuromi-bg { background-color: #FFF0F2; }
.baku-bg { background-color: #F0E6FF; }

.text-left {
  display: flex;
  flex-direction: column;
}

.role-name {
  font-size: 36rpx;
  font-weight: 900;
  color: #4A3A3A;
  margin-bottom: 8rpx;
}

.role-desc {
  font-size: 24rpx;
  color: #9A8A8A;
  font-weight: 500;
}

/* pair section */
.pair-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20rpx;
}

.pair-icon {
  font-size: 70rpx;
}

.kuromi-text { color: #FF5C77; }
.baku-text { color: #A288E3; }

.my-code-tip {
  font-size: 28rpx;
  color: #9A8A8A;
  margin-bottom: 20rpx;
  text-align: center;
}

.my-code {
  font-size: 60rpx;
  font-weight: 900;
  letter-spacing: 12rpx;
  color: #4A3A3A;
  margin-bottom: 40rpx;
}

.copy-btn {
  width: 100% !important;
  font-size: 28rpx;
  font-weight: bold;
  background-color: #FFF0F2;
  color: #FF5C77;
  border: 4rpx solid #FF5C77;
  border-radius: 20rpx;
  padding: 24rpx 0;
  margin-bottom: 60rpx;
  box-shadow: none;
}
.copy-btn.copied {
  background-color: #E8F8F5;
  color: #20B2AA;
  border-color: #20B2AA;
}

.input-section {
  width: 100%;
  margin-bottom: 40rpx;
}

.input-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #4A3A3A;
  margin-bottom: 20rpx;
  text-align: center;
}

.code-input {
  background-color: white;
  border: 6rpx solid #FFE8E8;
  border-radius: 24rpx;
  height: 120rpx;
  text-align: center;
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: 16rpx;
  width: 100%;
  box-sizing: border-box;
  color: #4A3A3A;
}

.error-text {
  color: #FF5C77;
  font-size: 24rpx;
  text-align: center;
  font-weight: bold;
  margin-top: 15rpx;
}

.bind-btn {
  width: 100% !important;
  margin-bottom: 40rpx;
  padding: 28rpx 0;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.kuromi-btn {
  background-color: #FF5C77;
  color: white;
  box-shadow: 0 8rpx 0 #D94A62;
}

.baku-btn {
  background-color: #A288E3;
  color: white;
  box-shadow: 0 8rpx 0 #8062C7;
}

.bind-btn[disabled] {
  background-color: #F5F5F5 !important;
  color: #C4B4B4 !important;
  box-shadow: 0 8rpx 0 #E5E5E5 !important;
}

.bind-btn:active:not([disabled]) {
  transform: translateY(8rpx);
  box-shadow: 0 0 0 transparent !important;
}

.back-link {
  font-size: 28rpx;
  font-weight: bold;
  color: #9A8A8A;
  padding: 20rpx;
}
