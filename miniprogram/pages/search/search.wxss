.search-page {
  padding: 30rpx;
  height: 100vh;
}
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}
.search-input {
  flex: 1;
  height: 80rpx;
  background: white;
  border: 2rpx solid var(--primary-color);
  border-radius: 40rpx;
  padding: 0 40rpx;
  font-size: 28rpx;
}
.search-btn {
  margin-left: 20rpx;
  background: var(--primary-color);
  color: white;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 40rpx;
  border-radius: 40rpx;
  font-weight: bold;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
  margin-top: 100rpx;
}
.tip-icon { font-size: 80rpx; margin-bottom: 20rpx; }

.kuromi-card {
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(195,158,212,0.15);
  border: 2rpx solid var(--kuromi-pink);
  padding: 40rpx;
}

.result-title, .form-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 20rpx;
}
.d-name { font-size: 36rpx; font-weight: bold; color: var(--primary-color); margin-bottom: 10rpx;}
.d-cat, .d-ing { font-size: 26rpx; color: #666; margin-bottom: 10rpx;}

.add-to-menu-btn {
  background-color: var(--primary-color);
  color: white;
  border-radius: 40rpx;
  margin-top: 30rpx;
}

.not-found-text {
  text-align: center;
  color: #ff6b6b;
  margin-bottom: 30rpx;
  font-weight: bold;
}

.form-input, .form-picker {
  height: 80rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
}
