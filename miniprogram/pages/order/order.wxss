.order-page {
  padding: 30rpx;
  height: 100vh;
  box-sizing: border-box;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  color: #999;
}
.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}
.order-list {
  width: 100%;
}
.order-card {
  padding: 30rpx;
  margin-bottom: 30rpx;
}
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx dashed #eee;
}
.dish-name {
  font-size: 34rpx;
  font-weight: bold;
}
.status-badge {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}
.status-badge.pending { background: #fff0f0; color: #ff6b6b; }
.status-badge.cooking { background: #f0f7ff; color: #4dabf7; }
.status-badge.done { background: #f4fce3; color: #82c91e; }

.ingredients-section {
  margin-bottom: 30rpx;
}
.section-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.ingredients-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.ingredient {
  font-size: 24rpx;
  background: #f5f5f5;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}
.action-bar {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}
.action-btn {
  margin: 0 !important;
  font-size: 28rpx;
  border-radius: 40rpx;
}
.primary-btn {
  background-color: var(--kuromi-purple);
  color: white;
}
.cuican-btn {
  background-color: #ff922b;
  color: white;
}
.finish-btn {
  background-color: #82c91e;
  color: white;
}
