<view class="menu-container">
  <!-- Top Banner (Illustration Placeholder) -->
  <view class="top-banner">
    <image class="banner-bg" src="/assets/menu-bg.svg" mode="aspectFill"></image>
    <view class="banner-curve"></view>
  </view>

  <!-- Main Content Area -->
  <view class="menu-content">
    
    <!-- Left Sidebar -->
    <scroll-view class="sidebar" scroll-y>
      <view class="sidebar-inner">
        <view 
          wx:for="{{categories}}" 
          wx:key="id"
          class="category-item {{activeCategory === item.id ? 'active' : ''}}"
          bindtap="switchCategory"
          data-id="{{item.id}}"
        >
          <image class="cat-icon {{activeCategory === item.id ? '' : 'inactive-icon'}}" src="{{'/assets/icon-' + item.id + '.svg'}}"></image>
          <text class="cat-text">{{item.name}}</text>
        </view>
        
        <!-- Cute illustration placeholder at bottom -->
        <view class="sidebar-bottom">
          <view class="sparkle-icon">✨</view>
        </view>
      </view>
    </scroll-view>

    <!-- Right Content -->
    <scroll-view class="dish-list-scroll" scroll-y scroll-into-view="cat-{{activeCategory}}" scroll-with-animation>
      <view class="dish-list-inner">
        
        <!-- Floating Search Bar -->
        <view class="search-bar" bindtap="goToSearch">
          <text class="search-icon">🔍</text>
          <text class="search-placeholder">想吃点什么？去许愿池搜索...</text>
        </view>

        <!-- Section Header -->
        <view class="section-header">
          <view class="header-left">
            <image class="avatar" src="/assets/avatar-kuromi.svg"></image>
            <view class="header-text">
              <view class="header-title">厨主推荐 ✨</view>
              <view class="header-subtitle">Kuromi和Baku的美味食光</view>
            </view>
          </view>
          <view class="new-tag">
            <text class="tag-icon">📢</text> 今日上新
          </view>
        </view>

        <!-- Dish List -->
        <block wx:for="{{categories}}" wx:key="id" wx:for-item="catItem">
          <view class="category-title" id="cat-{{catItem.id}}">{{catItem.name}} {{catItem.icon}}</view>
          
          <view class="dish-item" wx:for="{{displayDishes}}" wx:key="id" wx:if="{{item.category === catItem.id}}">
            <image class="dish-img" src="{{item.image || 'https://images.unsplash.com/photo-1563729784474-d77dbb933a9e?w=200&q=80'}}" mode="aspectFill"></image>
            <view class="dish-info">
              <view class="dish-top">
                <view class="dish-tag">
                  {{item.category === 'hot' ? '必吃 🔥' : item.category === 'home' ? '拿手 🔥' : item.category === 'meat' ? '吃肉 🥩' : item.category === 'veg' ? '解腻 🥬' : item.category === 'soup' ? '碳水 🥣' : item.category === 'sea' ? '海鲜 🦐' : item.category === 'snack' ? '解馋 🍟' : '甜甜 🍰'}}
                </view>
                <view class="dish-name">{{item.name}}</view>
                <view class="dish-desc">{{item.desc}}</view>
              </view>
              
              <view class="dashed-line"></view>

              <view class="dish-bottom">
                <view class="dish-price"><text class="price-symbol">¥</text> {{item.price}}</view>
                <view class="add-btn" catchtap="addToCart" data-dish="{{item}}" wx:if="{{role !== 'chef'}}">{{item.buttonText || '选它'}}</view>
                <view class="add-btn edit" wx:if="{{role === 'chef'}}">编辑</view>
              </view>
            </view>
          </view>
        </block>

        <!-- Bottom padding for cart -->
        <view style="height: 140rpx;"></view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部购物车 -->
  <view class="cart-bar" wx:if="{{role !== 'chef'}}">
    <view class="cart-left">
      <view class="cart-icon">🛍️<view class="badge" wx:if="{{cart.length > 0}}">{{cart.length}}</view></view>
      <view class="cart-info">
        <view class="cart-price">¥ {{cartTotal}}</view>
        <view class="cart-sub">共 {{cart.length}} 份，巴库正在等待接单</view>
      </view>
    </view>
    <view class="cart-right {{cart.length > 0 ? 'active' : ''}}" bindtap="checkout">
      去结账
    </view>
  </view>
</view>
