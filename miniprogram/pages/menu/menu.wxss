.menu-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #fff;
}
/* Banner */
.banner {
  width: 100%;
}
.banner-img {
  width: 100%;
  height: 240rpx;
}
.shop-info {
  padding: 20rpx 30rpx;
  border-bottom: 2rpx solid #eee;
}
.shop-title {
  font-size: 36rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
}
.share-btn {
  font-size: 24rpx;
  color: var(--primary-color);
  margin-left: 20rpx;
  font-weight: normal;
}
.shop-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 10rpx;
}

/* 菜单区域 */
.menu-body {
  display: flex;
  flex: 1;
  overflow: hidden;
  /* 留出底部购物车高度 */
  padding-bottom: 120rpx; 
}

/* 左侧侧边栏 */
.sidebar {
  width: 180rpx;
  background-color: var(--sidebar-bg);
  height: 100%;
}
.category-item {
  padding: 30rpx 20rpx;
  font-size: 26rpx;
  color: var(--text-main);
  text-align: center;
  position: relative;
  transition: all 0.2s;
}
.category-item.active {
  background-color: #fff;
  color: var(--primary-color);
  font-weight: bold;
}
.category-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 30rpx;
  bottom: 30rpx;
  width: 8rpx;
  background-color: var(--primary-color);
  border-radius: 0 8rpx 8rpx 0;
}

/* 右侧菜品 */
.dish-list {
  flex: 1;
  height: 100%;
  padding: 0 20rpx;
}
.category-title {
  font-size: 24rpx;
  color: var(--text-sub);
  padding: 20rpx 0;
}
.dish-item {
  display: flex;
  margin-bottom: 30rpx;
}
.dish-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background-color: #eee;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.dish-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
}
.dish-desc {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}
.dish-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}
.dish-price {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: bold;
}
.add-btn {
  background-color: var(--primary-color);
  color: white;
  font-size: 24rpx;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  font-weight: bold;
}
.add-btn.edit {
  background-color: #eee;
  color: #666;
}

/* 底部购物车 */
.cart-bar {
  position: fixed;
  bottom: 30rpx;
  left: 30rpx;
  right: 30rpx;
  height: 100rpx;
  background-color: #333;
  display: flex;
  z-index: 100;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 16rpx rgba(195,158,212,0.3);
  overflow: hidden;
}
.cart-left {
  flex: 1;
  display: flex;
  align-items: center;
  padding-left: 40rpx;
}
.cart-icon {
  font-size: 50rpx;
  position: relative;
  margin-right: 20rpx;
}
.badge {
  position: absolute;
  top: -10rpx;
  right: -20rpx;
  background-color: #FF5722;
  color: white;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
}
.cart-info {
  display: flex;
  flex-direction: column;
}
.cart-price {
  color: white;
  font-size: 32rpx;
  font-weight: bold;
}
.cart-sub {
  color: #aaa;
  font-size: 20rpx;
}
.cart-right {
  width: 220rpx;
  background-color: #555;
  color: #aaa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
}
.cart-right.active {
  background-color: var(--primary-color); 
  color: white;
}
