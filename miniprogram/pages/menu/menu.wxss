page {
  background-color: #FFFDF9;
  height: 100%;
}

.menu-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

/* Top Banner */
.top-banner {
  width: 100%;
  height: 320rpx;
  background-color: #FFF5F7;
  position: relative;
  overflow: hidden;
}

.banner-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  opacity: 0.6;
}

.banner-curve {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 48rpx;
  background-color: #FFFDF9;
  border-radius: 48rpx 48rpx 0 0;
}

/* Main Content Area */
.menu-content {
  display: flex;
  flex: 1;
  overflow: hidden;
  margin-top: -30rpx;
  z-index: 10;
  position: relative;
  background-color: transparent;
}

/* Left Sidebar */
.sidebar {
  width: 200rpx;
  background-color: #FFF5F7;
  height: 100%;
  border-right: 2rpx solid #FFE8E8;
}

.sidebar-inner {
  padding-top: 40rpx;
  padding-bottom: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100%;
}

.category-item {
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  border-radius: 32rpx;
  margin-bottom: 8rpx;
  transition: all 0.2s;
  border: 2rpx solid transparent;
}

.category-item.active {
  background-color: white;
  box-shadow: 0 8rpx 20rpx rgba(255,192,203,0.3);
  border: 2rpx solid #FFE0E5;
  transform: scale(1.05);
}

.cat-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 8rpx;
}

.inactive-icon {
  filter: grayscale(100%);
  opacity: 0.6;
}

.cat-text {
  font-size: 22rpx;
  font-weight: bold;
  color: #C4B4B4;
}

.category-item.active .cat-text {
  color: #FF5C77;
}

.sidebar-bottom {
  margin-top: auto;
  padding: 32rpx;
  opacity: 0.8;
}

.sparkle-icon {
  width: 96rpx;
  height: 96rpx;
  background-color: #FFF0F2;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  border: 2rpx solid #FFE0E5;
}

/* Right Content */
.dish-list-scroll {
  flex: 1;
  height: 100%;
  background-color: #FFFDF9;
}

.dish-list-inner {
  padding: 32rpx 24rpx;
}

/* Floating Search Bar */
.search-bar {
  background-color: white;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  margin-bottom: 32rpx;
  position: sticky;
  top: 0;
  z-index: 20;
  border: 2rpx solid #FFE8E8;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-placeholder {
  font-size: 26rpx;
  color: #C4B4B4;
}

/* Section Header */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.header-left {
  display: flex;
  align-items: center;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  border: 4rpx solid #FFE8E8;
  margin-right: 16rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #4A3A3A;
  line-height: 1.2;
}

.header-subtitle {
  font-size: 20rpx;
  color: #9A8A8A;
}

.new-tag {
  background-color: #FFF0F2;
  color: #FF7A7A;
  font-size: 20rpx;
  font-weight: bold;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  border: 2rpx solid #FFE0E5;
  display: flex;
  align-items: center;
}

.tag-icon {
  margin-right: 4rpx;
}

/* Category Title */
.category-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #4A3A3A;
  padding: 24rpx 0 16rpx 0;
}

/* Dish Item */
.dish-item {
  background-color: white;
  border-radius: 48rpx;
  padding: 24rpx;
  border: 6rpx solid #FFF0F2;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.02);
  display: flex;
  margin-bottom: 24rpx;
}

.dish-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 32rpx;
  border: 4rpx solid #FFF0F2;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.dish-top {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.dish-tag {
  background-color: #FFF0F2;
  color: #FF7A7A;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.dish-name {
  font-size: 32rpx;
  font-weight: 900;
  color: #4A3A3A;
  margin-bottom: 4rpx;
  letter-spacing: 2rpx;
}

.dish-desc {
  font-size: 22rpx;
  color: #9A8A8A;
  font-weight: 500;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.dashed-line {
  width: 100%;
  border-top: 4rpx dashed #FFF0F2;
  margin: 16rpx 0;
}

.dish-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.dish-price {
  font-size: 40rpx;
  color: #FF5C77;
  font-weight: 900;
  line-height: 1;
}

.price-symbol {
  font-size: 24rpx;
  margin-right: 4rpx;
}

.add-btn {
  background: linear-gradient(to bottom, #FFE787, #FFCF3D);
  color: #6B4B1B;
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 0 #E5B220;
}

.add-btn:active {
  transform: translateY(8rpx);
  box-shadow: 0 0 0 transparent;
}

.add-btn.edit {
  background: #eee;
  color: #666;
  box-shadow: none;
}

/* Cart Bar */
.cart-bar {
  position: fixed;
  bottom: 40rpx;
  left: 32rpx;
  right: 32rpx;
  height: 110rpx;
  background-color: #4A3A3A;
  display: flex;
  z-index: 100;
  border-radius: 55rpx;
  box-shadow: 0 16rpx 32rpx rgba(74, 58, 58, 0.3);
  overflow: hidden;
}

.cart-left {
  flex: 1;
  display: flex;
  align-items: center;
  padding-left: 48rpx;
}

.cart-icon {
  font-size: 56rpx;
  position: relative;
  margin-right: 24rpx;
  transform: translateY(-4rpx);
}

.badge {
  position: absolute;
  top: -4rpx;
  right: -16rpx;
  background-color: #FF5C77;
  color: white;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-weight: bold;
  border: 4rpx solid #4A3A3A;
}

.cart-info {
  display: flex;
  flex-direction: column;
}

.cart-price {
  color: white;
  font-size: 32rpx;
  font-weight: 900;
  margin-bottom: 2rpx;
}

.cart-sub {
  color: #9A8A8A;
  font-size: 20rpx;
  font-weight: 500;
}

.cart-right {
  width: 240rpx;
  background-color: #6A5A5A;
  color: #C4B4B4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 900;
}

.cart-right.active {
  background-color: #FF5C77;
  color: white;
}
