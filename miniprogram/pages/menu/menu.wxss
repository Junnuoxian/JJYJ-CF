.menu-page {
  padding: 30rpx;
  height: 100vh;
  box-sizing: border-box;
}
.header {
  width: 100%;
  margin-bottom: 30rpx;
}
.greeting {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--kuromi-dark);
}
.dish-list {
  flex: 1;
  width: 100%;
}
.dish-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 24rpx;
}
.dish-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}
.dish-tags {
  display: flex;
  gap: 12rpx;
}
.tag {
  font-size: 20rpx;
  background-color: var(--kuromi-pink);
  color: var(--kuromi-purple);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.add-btn {
  margin: 0 !important;
  padding: 0 40rpx !important;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 26rpx;
  background-color: var(--kuromi-purple);
  color: white;
  border-radius: 30rpx;
}
.edit-btn {
  background-color: #f0f0f0;
  color: #666;
}
