.my-page {
  padding: 30rpx;
  height: 100vh;
}
.kuromi-card {
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(195,158,212,0.15);
  border: 2rpx solid var(--kuromi-pink);
  padding: 40rpx;
  margin-bottom: 30rpx;
  display: flex;
}
/* 登录区 */
.unlogin-box {
  flex-direction: column;
  align-items: center;
}
.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background-color: #eee;
  border: 4rpx solid var(--kuromi-pink);
}
.unlogin-text {
  font-size: 32rpx;
  color: var(--text-sub);
  margin: 30rpx 0;
}
.login-btn {
  background-color: var(--primary-color);
  color: white;
  border-radius: 40rpx;
  font-size: 30rpx;
  width: 80% !important;
}

/* 已登录 */
.user-box {
  align-items: center;
}
.user-info {
  margin-left: 30rpx;
  display: flex;
  flex-direction: column;
}
.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 10rpx;
}
.role-badge {
  font-size: 24rpx;
  background-color: var(--primary-color);
  color: white;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  display: inline-block;
}

/* 绑定区 */
.bind-box {
  flex-direction: column;
}
.bind-header {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  border-bottom: 2rpx dashed #eee;
  padding-bottom: 20rpx;
}
.bind-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: var(--text-main);
}
.no-bind-text {
  color: var(--text-sub);
}
.action-btn {
  margin: 0 !important;
  font-size: 24rpx;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
}
.action-btn.invite {
  background-color: var(--primary-color);
  color: white;
}
.action-btn.unbind {
  background-color: #f5f5f5;
  color: #ff6b6b;
}

/* 退出登录 */
.bottom-actions {
  margin-top: 60rpx;
}
.logout-btn {
  background-color: #fff;
  color: #ff6b6b;
  border: 2rpx solid #ff6b6b;
  border-radius: 40rpx;
  width: 100% !important;
}
